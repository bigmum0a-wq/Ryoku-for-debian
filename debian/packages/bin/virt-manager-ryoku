#!/usr/bin/env bash
# Ryoku wrapper for virt-manager on Hyprland/Wayland.
#
# Issue: under Hyprland, GDK_BACKEND="wayland,x11,*" tells GTK to try Wayland
# first, then X11. Without XAUTHORITY set, the X11 fallback fails with
# "Authorization required". virt-manager 5.x supports native GTK4 Wayland,
# so we force the Wayland backend and avoid the X11 fallback.
#
# For libvirt access: the user belongs to the "libvirt" group,
# which grants passwordless access to qemu:///system via polkit.

# Force native Wayland: no X11 fallback, so XAUTHORITY is unnecessary
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland

# Ensure WAYLAND_DISPLAY is set (inherited from session, with safe fallback)
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

# XAUTHORITY: if XWayland is still used (GTK3 fallback),
# generate a MIT-MAGIC-COOKIE-1 cookie for the current display
if [ -n "$DISPLAY" ] && [ ! -s "${XAUTHORITY:-$HOME/.Xauthority}" ]; then
    export XAUTHORITY="$HOME/.Xauthority"
    xauth add "$DISPLAY" . "$(mcookie)" 2>/dev/null || true
fi

exec /usr/bin/virt-manager "$@"
