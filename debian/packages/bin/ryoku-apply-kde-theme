#!/usr/bin/env python3
"""
ryoku-apply-kde-theme
─────────────────────
Synchronizes Ryoku's Qt6 theme exclusively via qt6ct
(~/.config/qt6ct/qt6ct.conf and ~/.config/qt6ct/colors/ryoku.conf).

Never writes to ~/.config/kdeglobals, ~/.config/Kvantum/,
~/.local/share/color-schemes/, or ~/.local/share/plasma/, and has zero
dependencies on KDE tools (plasma-apply-colorscheme, lookandfeeltool,
kreadconfig6, kvantummanager). Ryoku remains 100% self-contained and never
interferes with KDE Plasma or any other desktop environment.

Usage: ryoku-apply-kde-theme [--no-apply]
"""

import os
import sys
import configparser

HOME = os.path.expanduser("~")
QT6CT_DIR = os.path.join(HOME, ".config", "qt6ct")
QT6CT_CONF = os.path.join(QT6CT_DIR, "qt6ct.conf")
QT6CT_COLOR = os.path.join(QT6CT_DIR, "colors", "ryoku.conf")
APPLY = "--no-apply" not in sys.argv


def is_ryoku_session() -> bool:
    desktop = (
        os.environ.get("XDG_CURRENT_DESKTOP", "")
        + ":"
        + os.environ.get("XDG_SESSION_DESKTOP", "")
    ).lower()
    if any(tok in desktop for tok in ("kde", "plasma", "gnome", "xfce", "mate", "lxqt", "cinnamon")):
        return False
    if any(tok in desktop for tok in ("hyprland", "ryoku", "niri", "wayfire")):
        return True
    return bool(os.environ.get("RYOKU_SESSION_KEY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"))


def sync_qt6ct_conf() -> None:
    os.makedirs(os.path.join(QT6CT_DIR, "colors"), exist_ok=True)
    cp = configparser.RawConfigParser()
    cp.optionxform = str  # preserve case
    if os.path.exists(QT6CT_CONF):
        cp.read(QT6CT_CONF, encoding="utf-8")

    if not cp.has_section("Appearance"):
        cp.add_section("Appearance")

    cp.set("Appearance", "custom_palette", "true")
    cp.set("Appearance", "color_scheme_path", QT6CT_COLOR)
    cur_icon = cp.get("Appearance", "icon_theme", fallback="").strip()
    # MacOS-3D places/scalable/*.svg are PNGs misnamed .svg; Qt6's SVG loader rejects them (blank folders).
    if not cur_icon or cur_icon == "MacOS-3D":
        ryoku_folders = os.path.join(HOME, ".local", "share", "icons", "ryoku-folders")
        default_icon = "ryoku-folders" if os.path.exists(ryoku_folders) else "Papirus-Dark"
        cp.set("Appearance", "icon_theme", default_icon)
    if not cp.has_option("Appearance", "style"):
        cp.set("Appearance", "style", "Fusion")

    tmp = QT6CT_CONF + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        cp.write(f, space_around_delimiters=False)
    os.replace(tmp, QT6CT_CONF)
    print(f"[ryoku-qt6ct] ✓ qt6ct configured: {QT6CT_CONF}")


if __name__ == "__main__":
    if APPLY and not is_ryoku_session():
        print(
            "[ryoku-qt6ct] Outside Ryoku session — skipping changes.",
            file=sys.stderr,
        )
        sys.exit(0)
    sync_qt6ct_conf()
