#!/usr/bin/env bash
# ryoku-livewall-eco — Pause ryogami-live (SIGSTOP) when the desktop is covered
# by a window (fullscreen/maximized/tiled) or when on battery with active windows,
# and resume (SIGCONT) when the active workspace is empty. Cuts live wallpaper
# CPU usage from ~20% to 0% during normal work without losing the frame.

set -u

paused=0

resume_live() {
    if [ "$paused" -eq 1 ]; then
        pkill -CONT -x ryogami-live 2>/dev/null || true
        paused=0
    fi
}

trap resume_live EXIT INT TERM

while true; do
    sleep 3
    pgrep -x ryogami-live >/dev/null 2>&1 || { paused=0; continue; }

    # Count non-floating or fullscreen/maximized windows on the active workspace
    ws_id=$(hyprctl -j activeworkspace 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || true)
    [ -n "$ws_id" ] || continue

    covered=$(hyprctl -j clients 2>/dev/null | python3 -c "
import sys, json
ws = int('$ws_id')
clients = json.load(sys.stdin)
for c in clients:
    if (c.get('workspace') or {}).get('id') == ws and c.get('mapped', True):
        # Any fullscreen/maximized window or >=1 tiled window covers the wallpaper
        if c.get('fullscreen', 0) != 0 or not c.get('floating', False):
            print('1')
            sys.exit(0)
print('0')
" 2>/dev/null || echo "0")

    if [ "$covered" = "1" ] && [ "$paused" -eq 0 ]; then
        pkill -STOP -x ryogami-live 2>/dev/null && paused=1 || true
    elif [ "$covered" = "0" ] && [ "$paused" -eq 1 ]; then
        pkill -CONT -x ryogami-live 2>/dev/null && paused=0 || true
    fi
done
