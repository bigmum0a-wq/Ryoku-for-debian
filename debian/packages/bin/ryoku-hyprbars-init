#!/usr/bin/env bash
# ryoku-hyprbars-init — Load and configure native Hyprland window titlebars (hyprbars)
# with Ryoku's 3 native window buttons (− stash, □ maximize, ✕ close).
set -u

BAR_SO=""
for candidate in \
  "/usr/lib/ryoku/hyprbars.so" \
  "${HOME}/.local/lib/ryoku/hyprbars.so"; do
  if [ -f "$candidate" ]; then
    BAR_SO="$candidate"
    break
  fi
done

[ -n "$BAR_SO" ] || exit 0
command -v hyprctl >/dev/null 2>&1 || exit 0

if ! hyprctl plugins list 2>/dev/null | grep -q "Plugin hyprbars"; then
  hyprctl plugin load "$BAR_SO" >/dev/null 2>&1 || exit 0
fi

hyprctl eval '
hl.config({
    plugin = {
        hyprbars = {
            bar_height = 24,
            bar_color = "rgba(0d1729ee)",
            ["col.text"] = "rgba(e2e8f0ff)",
            bar_text_size = 11,
            bar_text_align = "left",
            bar_padding = 10,
            bar_button_padding = 6,
            bar_part_of_window = true,
            bar_precedence_over_border = true,
            on_double_click = "hyprctl dispatch fullscreen 1",
        },
    },
})
hl.plugin.hyprbars.add_button({
    bg_color = "rgba(fb7185cc)",
    fg_color = "rgba(0d1729ff)",
    size = 16,
    icon = "✕",
    action = "hyprctl dispatch killactive",
})
hl.plugin.hyprbars.add_button({
    bg_color = "rgba(4ade80cc)",
    fg_color = "rgba(0d1729ff)",
    size = 16,
    icon = "□",
    action = "hyprctl dispatch fullscreen 1",
})
hl.plugin.hyprbars.add_button({
    bg_color = "rgba(facc15cc)",
    fg_color = "rgba(0d1729ff)",
    size = 16,
    icon = "−",
    action = "ryoku-winstash hide",
})
' >/dev/null 2>&1 || true
