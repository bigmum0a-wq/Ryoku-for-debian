#!/usr/bin/env bash
# ryoku-session-guard — Prevent desktop environment interference between Ryoku (Hyprland)
# and third-party desktop sessions (KDE Plasma, GNOME, XFCE, etc.).
#
# Usage:
#   ryoku-session-guard enter-ryoku   # Stop conflicting KDE/third-party DE daemons & apply Ryoku session look
#   ryoku-session-guard enter-other   # Stop Ryoku daemons & restore clean KDE/GTK look when in another DE
#   ryoku-session-guard auto          # Auto-detect current session and run the appropriate guard
set -u

ACTION="${1:-auto}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ryoku/session-guard"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"

is_ryoku_session() {
  [ -n "${RYOKU_SESSION_KEY:-}" ] && return 0
  [ "${RYOKU_ACTIVE:-0}" = "1" ] && return 0
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && return 0
  case "${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}" in
    *Hyprland*|*hyprland*|*Ryoku*|*ryoku*) return 0 ;;
  esac
  return 1
}

backup_file_once() {
  local src="$1"
  local name="$2"
  mkdir -p "$CACHE_DIR"
  if [ -f "$src" ] && [ ! -f "$CACHE_DIR/$name.pre-ryoku" ]; then
    cp -a "$src" "$CACHE_DIR/$name.pre-ryoku" 2>/dev/null || true
  fi
}

restore_file_if_ryoku() {
  local dst="$1"
  local name="$2"
  local marker="$3"
  if [ -f "$dst" ] && grep -q "$marker" "$dst" 2>/dev/null; then
    if [ -f "$CACHE_DIR/$name.pre-ryoku" ]; then
      cp -a "$CACHE_DIR/$name.pre-ryoku" "$dst" 2>/dev/null || true
    fi
  fi
}

enter_ryoku() {
  # 1. Stop conflicting KDE / GNOME / third-party desktop daemons & portals
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop \
      xdg-desktop-portal-kde.service \
      xdg-desktop-portal-gnome.service \
      plasma-plasmashell.service \
      plasma-kglobalaccel.service \
      plasma-polkit-agent.service \
      plasma-kded6.service \
      plasma-xembedsniproxy.service \
      plasma-gmenudbusmenuproxy.service \
      2>/dev/null || true
  fi

  pkill -u "${USER:-$(id -un)}" -x \
    plasmashell kglobalacceld kded6 xembedsniproxy gmenudbusmenuproxy \
    xdg-desktop-portal-kde xdg-desktop-portal-gnome \
    2>/dev/null || true

  # 2. Do not mutate shared ~/.config/kdeglobals, ~/.config/gtk-3.0, or global dconf.
  # Ryoku scopes its Qt/GTK styling strictly via session environment variables and qt6ct.
}

enter_other() {
  # 1. Stop all Ryoku systemd user units, entire cgroup slice & background daemons
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop \
      ryoku-session.target \
      ryoku-session.slice \
      ryoku-shell.service \
      ryoku-rashin.service \
      ryoku-prowl.service \
      ryoku-ai-usage.service \
      ryoku-palette-bridge.service \
      ryoku-idle.service \
      ryoku-eq.service \
      ryoku-clamshell.service \
      ryoku-bt-agent.service \
      ryoku-bootstrap.service \
      xdg-desktop-portal-hyprland.service \
      mako.service \
      2>/dev/null || true

    # Clear Ryoku-scoped environment variables from systemd --user so KDE/GNOME/XFCE
    # never inherit qt6ct, disabled Qt decorations, or Ryoku's Polkit agent flag.
    systemctl --user unset-environment \
      RYOKU_SESSION_KEY RYOKU_ACTIVE \
      QT_QPA_PLATFORMTHEME QT_WAYLAND_DISABLE_WINDOWDECORATION \
      GSK_RENDERER GDK_BACKEND GTK_THEME QT_QPA_PLATFORM \
      QT_AUTO_SCREEN_SCALE_FACTOR ELECTRON_OZONE_PLATFORM_HINT \
      RYOKU_POLKIT_AGENT XCURSOR_THEME XCURSOR_SIZE \
      2>/dev/null || true
  fi

  pkill -u "${USER:-$(id -un)}" -x \
    quickshell ryoku-shell ryoku-hub ryogami ryogami-live \
    hypridle hyprsunset hyprpicker ryoku-livewall-eco ryoku-bt-audio \
    mako dunst swaync \
    2>/dev/null || true
  pkill -u "${USER:-$(id -un)}" -f "quickshell.*winstash" 2>/dev/null || true

  # 2. Clean up any legacy gtk-decoration-layout=: left by older Ryoku versions without overwriting gsettings
  for f in "$CFG_DIR/gtk-3.0/settings.ini" "$CFG_DIR/gtk-4.0/settings.ini"; do
    if [ -f "$f" ]; then
      sed -i '/^gtk-decoration-layout=:/d' "$f" 2>/dev/null || true
    fi
  done

  # 3. Restore pre-Ryoku KDE/Kvantum/GTK CSS if RyokuDynamic was injected into shared files
  restore_file_if_ryoku "$CFG_DIR/kdeglobals" "kdeglobals" "RyokuDynamic"
  restore_file_if_ryoku "$CFG_DIR/Kvantum/kvantum.kvconfig" "kvantum.kvconfig" "RyokuDynamic"
  restore_file_if_ryoku "$CFG_DIR/gtk-3.0/gtk.css" "gtk3.css" "colors.css"
  restore_file_if_ryoku "$CFG_DIR/gtk-4.0/gtk.css" "gtk4.css" "colors.css"

  # Fallback if no backup existed and kdeglobals/kvantum still points to RyokuDynamic
  if [ -f "$CFG_DIR/kdeglobals" ] && grep -q "RyokuDynamic" "$CFG_DIR/kdeglobals" 2>/dev/null; then
    sed -i 's/RyokuDynamic/BreezeDark/g' "$CFG_DIR/kdeglobals" 2>/dev/null || true
  fi
  if [ -f "$CFG_DIR/Kvantum/kvantum.kvconfig" ] && grep -q "RyokuDynamic" "$CFG_DIR/Kvantum/kvantum.kvconfig" 2>/dev/null; then
    sed -i 's/RyokuDynamic/KvArcDark/g' "$CFG_DIR/Kvantum/kvantum.kvconfig" 2>/dev/null || true
  fi
}

case "$ACTION" in
  enter-ryoku) enter_ryoku ;;
  enter-other) enter_other ;;
  auto)
    if is_ryoku_session; then
      enter_ryoku
    else
      enter_other
    fi
    ;;
  *)
    echo "Usage: $0 {enter-ryoku|enter-other|auto}" >&2
    exit 2
    ;;
esac
