#!/usr/bin/env python3
"""
ryoku-dock-sync — Scan installed GUI .desktop applications and populate
dock.pinned in ~/.config/ryoku/shell.json on first setup (or with --force).

Respects user edits: if dock.pinnedConfigured is already true, exits without
overwriting unless --force is passed. Deduplicates variants (e.g. multiple
Firefox or Dolphin entries) and excludes system/admin tools.
"""
import configparser
import glob
import json
import os
import shlex
import sys

SHELL_JSON = os.path.expanduser("~/.config/ryoku/shell.json")

# Priority order for common direct-interaction user apps
PRIORITY_IDS = [
    "kitty",
    "org.kde.konsole",
    "alacritty",
    "firefox-esr",
    "firefox",
    "google-chrome",
    "chromium",
    "brave-browser",
    "org.kde.dolphin",
    "org.gnome.Nautilus",
    "thunar",
    "com.microsoft.VSCode",
    "code",
    "virt-manager",
    "org.kde.kate",
    "geany",
    "gimp",
    "org.kde.krita",
    "vlc",
]

# Skip internal, CLI-only, or system-admin utilities from the user dock
EXCLUDE_PREFIXES = (
    "cyberpunk-",
    "debian-",
    "idle",
    "install-app",
    "bleachbit",
    "python",
    "openjdk",
    "avahi-",
    "bssh",
    "bvnc",
    "qv4l2",
    "qvidcap",
    "lstopo",
    "xgps",
    "blueman-",
    "gufw",
    "firewall",
    "kdesystemsettings",
    "systemsettings",
    "gnome-control-center",
    "nm-connection-editor",
    "pavucontrol",
    "htop",
    "btop",
    "xterm",
    "uxterm",
    "fish",
    "vim",
    "nvim",
    "firefox-selector",
    "ryoku-",
    "org.gnome.Settings",
    "xfce4-settings",
    "xfce4-about",
)

# Canonical family aliases so variants of the same app never duplicate
FAMILY_ALIASES = {
    "firefox": "firefox",
    "firefox-esr": "firefox",
    "firefox-bin": "firefox",
    "firefox-nightly": "firefox",
    "firefox-developer-edition": "firefox",
    "google-chrome": "google-chrome",
    "google-chrome-stable": "google-chrome",
    "code-oss": "vscode",
    "codium": "vscode",
    "com.microsoft.vscode": "vscode",
    "com.visualstudio.codeoss": "vscode",
    "code": "vscode",
    "dolphin": "dolphin",
    "org.kde.dolphin": "dolphin",
    "nautilus": "nautilus",
    "org.gnome.nautilus": "nautilus",
    "kate": "kate",
    "org.kde.kate": "kate",
    "konsole": "konsole",
    "org.kde.konsole": "konsole",
}

MAX_PINS = 12


def app_family_key(desktop_id, name, exec_cmd):
    low_id = desktop_id.lower()
    if low_id in FAMILY_ALIASES:
        return FAMILY_ALIASES[low_id]
    # Normalize Exec binary name
    exe = ""
    if exec_cmd:
        try:
            parts = shlex.split(exec_cmd)
            if parts:
                exe = os.path.basename(parts[0]).lower()
        except Exception:
            exe = os.path.basename(exec_cmd.split()[0]).lower()
    if exe in FAMILY_ALIASES:
        return FAMILY_ALIASES[exe]
    if exe:
        return f"exe:{exe}"
    return f"name:{name.strip().lower()}"


def is_system_clutter(desktop_id, categories_raw):
    low_id = desktop_id.lower()
    if low_id.startswith(EXCLUDE_PREFIXES):
        return True
    cats = {c.strip() for c in (categories_raw or "").split(";") if c.strip()}
    # Exclude pure Settings/System utilities unless they are a user terminal/file manager
    if cats & {"Settings", "HardwareSettings", "PackageManager"}:
        if not (cats & {"TerminalEmulator", "FileManager", "WebBrowser", "Development", "Graphics", "AudioVideo", "Office"}):
            return True
    return False


def scan_installed_apps():
    found = {}
    for d in ["/usr/share/applications", os.path.expanduser("~/.local/share/applications")]:
        if not os.path.isdir(d):
            continue
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            desktop_id = os.path.basename(path)[:-8]
            cp = configparser.ConfigParser(interpolation=None)
            try:
                cp.read(path, encoding="utf-8")
                if not cp.has_section("Desktop Entry"):
                    continue
                e = cp["Desktop Entry"]
                if e.get("Type") != "Application":
                    continue
                if e.get("NoDisplay", "").lower() == "true":
                    continue
                if e.get("Hidden", "").lower() == "true":
                    continue
                if e.get("Terminal", "").lower() == "true" and desktop_id not in ("kitty", "org.kde.konsole", "alacritty"):
                    continue
                if not e.get("Icon", "").strip():
                    continue
                if is_system_clutter(desktop_id, e.get("Categories", "")):
                    continue
                name = e.get("Name", desktop_id).strip()
                exec_cmd = e.get("Exec", "").strip()
                family = app_family_key(desktop_id, name, exec_cmd)
                found[desktop_id] = {
                    "name": name,
                    "family": family,
                    "name_key": name.lower(),
                }
            except Exception:
                continue
    return found


def main():
    force = "--force" in sys.argv
    max_pins = MAX_PINS
    if "--max" in sys.argv:
        try:
            idx = sys.argv.index("--max")
            max_pins = int(sys.argv[idx + 1])
        except Exception:
            pass

    if not os.path.isfile(SHELL_JSON):
        print(f"ryoku-dock-sync: {SHELL_JSON} not found", file=sys.stderr)
        return 1

    with open(SHELL_JSON, "r", encoding="utf-8") as f:
        data = json.load(f)

    dock = data.setdefault("dock", {})
    if not force and dock.get("pinnedConfigured") is True:
        # Respect user's customized dock pins across reboots/reloads
        return 0

    found = scan_installed_apps()
    ordered = []
    seen_ids = set()
    seen_families = set()
    seen_names = set()

    def try_add(app_id):
        info = found.get(app_id)
        if not info:
            return False
        if app_id in seen_ids or info["family"] in seen_families or info["name_key"] in seen_names:
            return False
        ordered.append(app_id)
        seen_ids.add(app_id)
        seen_families.add(info["family"])
        seen_names.add(info["name_key"])
        return True

    for app_id in PRIORITY_IDS:
        try_add(app_id)

    for app_id in sorted(found.keys(), key=lambda k: found[k]["name_key"]):
        if len(ordered) >= max_pins:
            break
        try_add(app_id)

    dock["pinned"] = ordered
    dock["pinnedConfigured"] = True

    tmp = SHELL_JSON + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, SHELL_JSON)

    print(f"ryoku-dock-sync: {len(ordered)} apps pinned -> {', '.join(ordered)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
