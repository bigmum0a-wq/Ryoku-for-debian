#!/usr/bin/env python3
"""
ryoku-winstash — Window stashing, arc-stack UI & per-window touch controls for Hyprland (Lua IPC).

Commands:
  hide                Move the currently active window to special:stash (or back if already stashed)
  hide-addr <addr>    Move a specific window <addr> to special:stash
  list                Print deduplicated JSON list of windows currently in special:stash
  focus <addr>        Bring <addr> from special:stash to the active workspace
  maximize <addr>     Focus <addr> and toggle Hyprland maximized state
  close <addr>        Close <addr>
  restore-all         Bring all stashed windows back to the active workspace
  toggle-ui           Toggle the expanded concentric-arc UI state file
  win-list            Print JSON list of visible windows on the active workspace (for corner controls)
  controls-toggle     Toggle per-window corner controls (enabled by default, user-configurable)
"""
import json
import os
import subprocess
import sys

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
UI_STATE_FILE = os.path.join(RUNTIME_DIR, "ryoku-winstash-open")
ORDER_FILE = os.path.join(RUNTIME_DIR, "ryoku-winstash-order.json")
CONTROLS_CFG_FILE = os.path.expanduser("~/.config/ryoku/wincontrols.json")

STASH_WS_NAME = "ryoku-stash"
STASH_WS_TARGET = "name:ryoku-stash"


def is_stashed_ws(ws):
    name = (ws or {}).get("name", "")
    return name in (STASH_WS_NAME, "special:stash")


def load_lifo_order():
    if os.path.isfile(ORDER_FILE):
        try:
            with open(ORDER_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, list):
                return [str(x) for x in data]
        except Exception:
            pass
    return []


def save_lifo_order(order):
    tmp = ORDER_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(order, f)
    os.replace(tmp, ORDER_FILE)


def lifo_push(addr):
    order = [a for a in load_lifo_order() if a != addr]
    order.insert(0, addr)
    save_lifo_order(order)


def lifo_remove(addr):
    order = [a for a in load_lifo_order() if a != addr]
    save_lifo_order(order)


def lifo_clear():
    save_lifo_order([])

# Apps that natively have no client-side titlebar/close/maximize buttons (Wayland/X11)
BORDERLESS_CLASSES = {
    "kitty", "foot", "footclient", "alacritty", "org.wezfurlong.wezterm",
    "wezterm-gui", "com.mitchellh.ghostty", "ghostty", "xterm", "uxterm",
    "rxvt", "urxvt", "st", "st-256color",
    "mpv", "imv", "feh", "sxiv", "nsxiv", "zathura", "org.pwmt.zathura",
}


def load_controls_cfg():
    cfg = {"mode": "borderless", "include": [], "exclude": []}
    if os.path.isfile(CONTROLS_CFG_FILE):
        try:
            with open(CONTROLS_CFG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                cfg.update(data)
        except Exception:
            pass
    return cfg


def save_controls_cfg(cfg):
    os.makedirs(os.path.dirname(CONTROLS_CFG_FILE), exist_ok=True)
    tmp = CONTROLS_CFG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONTROLS_CFG_FILE)


def hypr_json(cmd):
    out = subprocess.check_output(["hyprctl", "-j", cmd], text=True)
    return json.loads(out)


def lua_dispatch(expr):
    subprocess.run(
        ["hyprctl", "dispatch", expr],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def active_ws_id():
    ws = hypr_json("activeworkspace")
    return int(ws.get("id", 1))


def special_ws_name():
    monitors = hypr_json("monitors")
    for m in monitors:
        if m.get("focused"):
            return (m.get("specialWorkspace") or {}).get("name", "")
    return ""


def first_visible_addr(ws_id, clients=None, exclude_addr=None):
    """Return the address of the most-recently-focused visible window on ws_id.

    exclude_addr: skip this address (use when the caller just stashed a window
                  and the client list was fetched before the move; without this
                  the stashed window would be returned as the fallback and
                  Hyprland would ghost-focus it, reopening the stash overlay).
    """
    if clients is None:
        clients = hypr_json("clients")
    candidates = []
    for c in clients:
        if not c.get("mapped", True) or c.get("hidden", False):
            continue
        if is_overlay_client(c):
            continue
        if exclude_addr and c.get("address") == exclude_addr:
            continue
        ws = c.get("workspace") or {}
        if ws.get("id") != ws_id or ws.get("name", "").startswith("special:") or is_stashed_ws(ws):
            continue
        candidates.append(c)
    if not candidates:
        return None
    # Sort by focusHistoryID ascending (lower = more recently focused in Hyprland)
    candidates.sort(key=lambda c: c.get("focusHistoryID", 9999))
    return candidates[0].get("address")


def close_stash_and_refocus(ws_id, exclude_addr=None):
    """Hide special:stash overlay and hand keyboard focus to a real visible window.

    Hyprland keeps keyboard focus on the last window that had it, even when that
    window is in a hidden special workspace. Any surface that briefly grabs and
    releases the keyboard (a bar panel, a popup menu) then returns focus to that
    hidden window and shows the special workspace again. Explicitly focusing a
    concrete visible window on the normal workspace prevents this ghost-focus.

    exclude_addr: address of a window that was just stashed — must not be used
                  as the focus target even if it still appears in a stale list.
    """
    if special_ws_name() == "special:stash":
        lua_dispatch('hl.dsp.workspace.toggle_special("stash")')

    # Fetch a FRESH client list so the just-stashed window no longer appears
    # on the normal workspace (the move dispatch completed synchronously above).
    fresh_clients = hypr_json("clients")
    target = first_visible_addr(ws_id, fresh_clients, exclude_addr=exclude_addr)
    if target:
        lua_dispatch(f'hl.dsp.focus({{ window = "address:{target}" }})')
    else:
        lua_dispatch(f'hl.dsp.focus({{ workspace = {ws_id} }})')


def is_overlay_client(c):
    cls = (c.get("class") or c.get("initialClass") or "").lower()
    title = (c.get("title") or "").lower()
    return cls in ("quickshell", "org.quickshell") or "ryoku-winstash" in title


def cmd_hide_addr(addr):
    if not addr:
        return 1
    clients = hypr_json("clients")
    target = next((c for c in clients if c.get("address") == addr), None)
    if not target or is_overlay_client(target):
        return 0
    ws = target.get("workspace") or {}
    ws_name = ws.get("name", "")
    back = active_ws_id()
    if ws_name.startswith("special:") or is_stashed_ws(ws):
        lifo_remove(addr)
        lua_dispatch(f'hl.dsp.window.move({{ workspace = {back}, window = "address:{addr}" }})')
        lua_dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
    else:
        lifo_push(addr)
        lua_dispatch(f'hl.dsp.window.move({{ workspace = "{STASH_WS_TARGET}", follow = false, window = "address:{addr}" }})')

        # Hand focus to the next most-recent visible window on back (LIFO),
        # excluding the just-stashed window.
        close_stash_and_refocus(back, exclude_addr=addr)
    return 0


def cmd_pop_lifo():
    """Restore ONLY the most-recently-stashed window (Last In, First Out)."""
    clients = hypr_json("clients")
    stashed_addrs = {
        c.get("address"): c
        for c in clients
        if c.get("address") and c.get("mapped", True) and not is_overlay_client(c)
        and is_stashed_ws(c.get("workspace"))
    }
    if not stashed_addrs:
        return 0
    order = [a for a in load_lifo_order() if a in stashed_addrs]
    target_addr = order[0] if order else next(iter(stashed_addrs))
    return cmd_focus(target_addr)


def cmd_pop_if_empty():
    """Restore ONLY the last-stashed window (LIFO) if the active workspace has 0 visible windows."""
    ws_id = active_ws_id()
    if first_visible_addr(ws_id) is not None:
        return 0
    return cmd_pop_lifo()


def cmd_hide():
    ws_id = active_ws_id()
    win = hypr_json("activewindow")
    addr = win.get("address")
    if not addr:
        # No visible window is open on the active workspace → LIFO restore of the last stashed window.
        return cmd_pop_lifo()
    # If the focused window is already on the normal workspace, stash it;
    # if somehow no visible window is on ws_id, pop LIFO instead.
    if first_visible_addr(ws_id) is None and (win.get("workspace") or {}).get("id") != ws_id:
        return cmd_pop_lifo()
    return cmd_hide_addr(addr)


def cmd_list():
    clients = hypr_json("clients")
    by_addr = {}
    for c in clients:
        addr = c.get("address", "")
        if not addr or addr in by_addr or not c.get("mapped", True):
            continue
        if is_overlay_client(c):
            continue
        ws = c.get("workspace") or {}
        if is_stashed_ws(ws):
            by_addr[addr] = {
                "address": addr,
                "class": c.get("class") or c.get("initialClass") or "app",
                "title": c.get("title") or c.get("initialTitle") or "Window",
                "pid": c.get("pid", 0),
                "_focus": c.get("focusHistoryID", 9999),
            }

    # Strict LIFO ordering: index 0 = most recently stashed window
    order = [a for a in load_lifo_order() if a in by_addr]
    stashed = []
    seen = set()
    for a in order:
        item = by_addr[a]
        stashed.append({k: v for k, v in item.items() if not k.startswith("_")})
        seen.add(a)
    remaining = sorted(
        (v for a, v in by_addr.items() if a not in seen),
        key=lambda x: x["_focus"],
    )
    for item in remaining:
        order.append(item["address"])
        stashed.append({k: v for k, v in item.items() if not k.startswith("_")})
    save_lifo_order(order)
    print(json.dumps(stashed))
    return 0


def monitor_logical_size(mon_id, monitors):
    for m in monitors:
        if m.get("id") == mon_id:
            scale = float(m.get("scale", 1.0) or 1.0)
            return (m.get("width", 1280) / scale, m.get("height", 720) / scale)
    return (1280.0, 720.0)


def window_size_state(c, monitors):
    w, h = (c.get("size") or [0, 0])[:2]
    mon_w, mon_h = monitor_logical_size(c.get("monitor", 0), monitors)
    fs = c.get("fullscreen", 0)
    fl = c.get("floating", False)
    if fs != 0 or (w >= mon_w * 0.88 and h >= mon_h * 0.82):
        return "max", mon_w, mon_h
    if fl and w >= mon_w * 0.60:
        return "medium", mon_w, mon_h
    if fl:
        return "compact", mon_w, mon_h
    return "normal", mon_w, mon_h


def cmd_win_list():
    cfg = load_controls_cfg()
    mode = cfg.get("mode", "borderless")
    if mode == "off":
        print("[]")
        return 0
    include_set = {c.lower() for c in cfg.get("include", [])}
    exclude_set = {c.lower() for c in cfg.get("exclude", [])}

    ws_id = active_ws_id()
    clients = hypr_json("clients")
    monitors = hypr_json("monitors")
    # Sort topmost-first (lower focusHistoryID = closer to top) so we can hide
    # pills on background windows that are occluded by foreground windows.
    ordered = sorted(clients, key=lambda c: c.get("focusHistoryID", 9999))
    wins = []
    seen = set()
    higher_rects = []
    pill_w, pill_h = 76, 22
    for c in ordered:
        addr = c.get("address", "")
        if not addr or addr in seen or not c.get("mapped", True) or c.get("hidden", False):
            continue
        if is_overlay_client(c):
            continue
        ws = c.get("workspace") or {}
        if ws.get("id") != ws_id:
            continue
        seen.add(addr)
        size = c.get("size") or [0, 0]
        at = c.get("at") or [0, 0]
        cls = (c.get("class") or c.get("initialClass") or "").lower()
        eligible = (
            cls not in exclude_set
            and (mode != "borderless" or cls in BORDERLESS_CLASSES or cls in include_set)
            and size[0] >= 120
            and size[1] >= 80
        )
        if eligible:
            px = max(4, at[0] + size[0] - pill_w - 8)
            py = max(4, at[1] + 6)
            occluded = any(
                px < hx + hw and px + pill_w > hx and py < hy + hh and py + pill_h > hy
                for hx, hy, hw, hh in higher_rects
            )
            if not occluded:
                size_state, _, _ = window_size_state(c, monitors)
                wins.append({
                    "address": addr,
                    "class": cls,
                    "x": at[0],
                    "y": at[1],
                    "w": size[0],
                    "h": size[1],
                    "fullscreen": c.get("fullscreen", 0),
                    "sizeState": size_state,
                })
        if size[0] > 0 and size[1] > 0:
            higher_rects.append((at[0], at[1], size[0], size[1]))
    print(json.dumps(wins))
    return 0


def cmd_focus(addr, swap=False):
    if not addr:
        return 1
    ws_id = active_ws_id()
    prev_addr = None
    if swap:
        active = hypr_json("activewindow")
        prev_addr = active.get("address")
        if prev_addr == addr or is_overlay_client(active):
            prev_addr = None
    lifo_remove(addr)
    lua_dispatch(f'hl.dsp.window.move({{ workspace = {ws_id}, window = "address:{addr}" }})')
    lua_dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
    if swap and prev_addr:
        lifo_push(prev_addr)
        lua_dispatch(f'hl.dsp.window.move({{ workspace = "{STASH_WS_TARGET}", follow = false, window = "address:{prev_addr}" }})')
    # Close the stash overlay; focus was already given to addr above.
    if special_ws_name() == "special:stash":
        lua_dispatch('hl.dsp.workspace.toggle_special("stash")')
    try:
        os.remove(UI_STATE_FILE)
    except FileNotFoundError:
        pass
    return 0


def cmd_maximize(addr):
    if not addr:
        return 1
    clients = hypr_json("clients")
    monitors = hypr_json("monitors")
    target = next((c for c in clients if c.get("address") == addr), None)
    if not target:
        return 1

    state, mon_w, mon_h = window_size_state(target, monitors)
    lua_dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')

    if state == "max":
        # Shrink from full/maximized screen limits -> Medium floating (74% x 74% centered)
        if target.get("fullscreen", 0) != 0:
            lua_dispatch('hl.dsp.window.fullscreen({ mode = "maximized" })')
        if not target.get("floating", False):
            lua_dispatch('hl.dsp.window.float({ action = "toggle" })')
        mw = max(360, int(mon_w * 0.74))
        mh = max(280, int(mon_h * 0.74))
        lua_dispatch(f'hl.dsp.window.resize({{ x = {mw}, y = {mh}, exact = true }})')
        lua_dispatch('hl.dsp.window.center()')
    elif state == "medium":
        # Shrink further -> Compact floating (48% x 52% centered)
        cw = max(300, int(mon_w * 0.48))
        ch = max(220, int(mon_h * 0.52))
        lua_dispatch(f'hl.dsp.window.resize({{ x = {cw}, y = {ch}, exact = true }})')
        lua_dispatch('hl.dsp.window.center()')
    elif state == "compact":
        # Restore back to tiled / full layout
        if target.get("floating", False):
            lua_dispatch('hl.dsp.window.float({ action = "toggle" })')
    else:
        # Normal tiled side-by-side -> Maximize
        lua_dispatch('hl.dsp.window.fullscreen({ mode = "maximized" })')
    return 0


def cmd_close(addr):
    if not addr:
        return 1
    lua_dispatch(f'hl.dsp.window.close({{ window = "address:{addr}" }})')
    return 0


def cmd_restore_all():
    ws_id = active_ws_id()
    clients = hypr_json("clients")
    for c in clients:
        ws = c.get("workspace") or {}
        if is_stashed_ws(ws):
            addr = c.get("address")
            if addr:
                lua_dispatch(f'hl.dsp.window.move({{ workspace = {ws_id}, follow = false, window = "address:{addr}" }})')
    lifo_clear()
    close_stash_and_refocus(ws_id)
    try:
        os.remove(UI_STATE_FILE)
    except FileNotFoundError:
        pass
    return 0


def cmd_toggle_ui():
    if os.path.exists(UI_STATE_FILE):
        os.remove(UI_STATE_FILE)
    else:
        with open(UI_STATE_FILE, "w", encoding="utf-8") as f:
            f.write("1")
    return 0


def cmd_controls_toggle(app_class=None):
    cfg = load_controls_cfg()
    if app_class:
        cls = app_class.lower()
        exc = [c.lower() for c in cfg.get("exclude", [])]
        if cls in exc:
            exc.remove(cls)
        else:
            exc.append(cls)
        cfg["exclude"] = exc
    else:
        cfg["mode"] = "borderless" if cfg.get("mode") == "off" else "off"
    save_controls_cfg(cfg)
    return 0


def cmd_controls_mode(new_mode):
    if new_mode not in ("borderless", "all", "off"):
        return 1
    cfg = load_controls_cfg()
    cfg["mode"] = new_mode
    save_controls_cfg(cfg)
    return 0


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    action = sys.argv[1]
    if action == "hide":
        return cmd_hide()
    if action == "hide-addr" and len(sys.argv) >= 3:
        return cmd_hide_addr(sys.argv[2])
    if action == "list":
        return cmd_list()
    if action == "win-list":
        return cmd_win_list()
    if action == "focus" and len(sys.argv) >= 3:
        swap = "--swap" in sys.argv
        return cmd_focus(sys.argv[2], swap=swap)
    if action == "maximize" and len(sys.argv) >= 3:
        return cmd_maximize(sys.argv[2])
    if action == "close" and len(sys.argv) >= 3:
        return cmd_close(sys.argv[2])
    if action == "restore-all":
        return cmd_restore_all()
    if action == "toggle-ui":
        return cmd_toggle_ui()
    if action == "controls-toggle":
        return cmd_controls_toggle(sys.argv[2] if len(sys.argv) >= 3 else None)
    if action == "controls-mode" and len(sys.argv) >= 3:
        return cmd_controls_mode(sys.argv[2])
    if action == "pop-if-empty":
        return cmd_pop_if_empty()
    print(__doc__)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
