[Unit]
Description=Ryoku clamshell policy daemon
ConditionUser=!@system
PartOf=ryoku-session.target
After=ryoku-session.target
ConditionEnvironment=RYOKU_SESSION_KEY
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/ryoku-clamshell daemon
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
Slice=ryoku-session.slice

KillMode=control-group
[Install]
WantedBy=ryoku-session.target
