[Unit]
Description=Ryoku idle policy daemon
ConditionUser=!@system
PartOf=ryoku-session.target
After=ryoku-session.target
ConditionEnvironment=RYOKU_SESSION_KEY
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/ryoku-idle start
Restart=on-failure
RestartSec=2
Slice=ryoku-session.slice

KillMode=control-group
[Install]
WantedBy=ryoku-session.target
