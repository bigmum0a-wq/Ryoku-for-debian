[Unit]
# Refreshes only the usage caches whose matching CLI is installed; the timer
# calls one guard so absent optional tools never launch their collectors.
# Driven by ryoku-ai-usage.timer, never enabled on its own.
Description=Ryoku AI usage collectors

PartOf=ryoku-session.target
ConditionEnvironment=RYOKU_SESSION_KEY
[Service]
Type=oneshot
ExecStart=/usr/bin/ryoku-ai-usage
Slice=ryoku-session.slice
KillMode=control-group
